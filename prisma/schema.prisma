// Nail Fest — Slice 1 data model
// CRM (deduplicated person), events/registrations, consent-by-purpose,
// Meta attribution log, and email broadcast log.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) — the app's normal query traffic.
  url       = env("DATABASE_URL")
  // Direct/unpooled — Prisma Migrate needs this, not the pooled URL
  // (pooled + migrations => "prepared statement already exists" errors).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

// One row per human being, deduplicated by email/phone. This is the "single
// profile" the whole plan is built around — registrations, consents and
// audience segments all hang off this, not off a per-event record.
model Person {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String? // E.164, e.g. +57...
  firstName String?
  lastName  String?
  city      String?
  // Free-form categorical field (e.g. "manicurista", "estudiante").
  // Kept as a plain string + a lookup table of known options (ProfessionOption)
  // rather than true text so it stays usable as a segment filter — see
  // docs/PLAN.md "campos personalizables como filtros de segmentación".
  profession String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]
  consents      Consent[]
  whatsappConversations WhatsAppConversation[]
  labels        Label[]

  @@index([phone])
  @@index([city])
  @@index([profession])
}

// Reusable, organizer-managed list of profession/category options so the
// registration form uses a <select>, never free text — see brief. Now
// genuinely admin-editable from the Checkout form's "Profesión" question
// (see lib/professions.ts's syncProfessionOptions) instead of a read-only
// seed — `order` is what makes that editing actually stick: the admin's
// textarea order is saved here and read back the same way, rather than
// re-sorting by the original seed list every time.
model ProfessionOption {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)
  order  Int     @default(0)
}

// Draft = not linkable/registerable yet (see the public event page's own
// gate) — matches Ticket Tailor's own Draft/Published events. `@default
// (PUBLISHED)` at the DB level is a migration-safety default, not a
// product default: it backfills every event that existed before this
// column did (already-live events people are actively registering for)
// as still-live, rather than silently yanking them offline. The admin
// create form (lib/events.ts's createEvent) is what actually defaults a
// brand-new event to DRAFT, matching Ticket Tailor's real behavior.
enum EventStatus {
  DRAFT
  PUBLISHED
}

model Event {
  id           String      @id @default(cuid())
  slug         String      @unique // used in the landing URL, e.g. /bogota-2026
  name         String
  city         String
  // Shown on the public event page and in the confirmation email, not
  // just admin-internal — attendees need to know where to physically go,
  // not only which city (see /admin/events' own screenshots comparison).
  venueName    String?
  venueAddress String?
  // Shown on the public event page above the registration form. Sanitized
  // HTML from the real rich-text editor (RichTextEditor.tsx, TipTap) —
  // sanitized server-side (lib/sanitizeHtml.ts) before it's ever stored,
  // since it renders back out via dangerouslySetInnerHTML on a public,
  // unauthenticated page.
  description  String?
  // Vercel Blob URL (see /api/admin/uploads/event-image) — null until an
  // admin uploads one; the public page and EventForm's preview both just
  // skip the hero image when this is null instead of showing a broken img.
  imageUrl     String?
  // The public page's registration submit button — Ticket Tailor's own
  // "Select tickets button label" field, renamed here since we have no
  // ticket-selection step (RegistrationForm.tsx just submits straight to
  // /api/register). Defaults to "Registrarme GRATIS" on create, not at
  // the DB level, so existing events keep whatever they already show
  // (see lib/events.ts's createEvent) instead of silently changing.
  registerButtonLabel String?
  status       EventStatus @default(PUBLISHED)
  startsAt     DateTime
  endsAt       DateTime?
  capacity     Int?
  // Per-event override of the confirmation email — see OrgSettings.
  // confirmationEmailHtml's own comment for the full fallback chain
  // (this -> the account-wide template -> the original hand-built
  // design). Null (the default) means this event just uses whatever the
  // account-wide template resolves to.
  confirmationEmailHtml String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  registrations Registration[]
  scans         ScanLog[]
  ticketTypes   TicketType[]
  broadcasts    EmailBroadcast[]
  whatsappBroadcasts WhatsAppBroadcast[]

  @@index([city])
  @@index([status])
}

// Ticket Tailor's own "ticket type" concept, kept even though every Nail
// Fest event is free today (price defaults to, and in practice always
// is, 0) — the admin explicitly wants the real structure to exist ahead
// of any payment processor, not a placeholder for one. See
// /admin/events/[id]/edit's "Tickets and items" section and its own
// "Add a new ticket type" modal (TicketTypeModal.tsx), built field for
// field off Ticket Tailor's real modal.
enum TicketTypeStatus {
  ON_SALE
  HIDDEN
  ACCESS_CODE_REQUIRED
  SOLD_OUT // "Display as Sold Out"
  UNAVAILABLE // "Display as Unavailable"
  ADMIN_ONLY // "Only visible to admin"
}

// Whether a registration under this ticket type gets one QR per physical
// ticket or one shared QR for the whole order — captured for real here,
// but /api/register and /admin/scan don't branch on it yet (both still
// issue exactly one QR per registration, today's only behavior); that's
// a real follow-up, not silently dropped — see TicketTypesSection.tsx's
// own comment.
enum TicketIssuance {
  INDIVIDUAL
  GROUP
}

model TicketType {
  id          String           @id @default(cuid())
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  name        String
  quantity    Int
  // Whole units of DEFAULT_CURRENCY (COP has no everyday sub-unit) — 0 for
  // every Nail Fest event today since there's no payment processor wired
  // up, but the field is real, not hardcoded, so it's ready the day that
  // changes.
  price       Int              @default(0)
  bookingFee  Int              @default(0)
  description String?
  status      TicketTypeStatus @default(ON_SALE)
  minPerOrder Int              @default(1)
  maxPerOrder Int              @default(20)
  issuance    TicketIssuance   @default(INDIVIDUAL)
  hideUntil   DateTime?
  hideAfter   DateTime?
  hideWhenSoldOut        Boolean @default(false)
  showRemainingOnPage    Boolean @default(false)
  excludeFromLowestPrice Boolean @default(false)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  registrations Registration[]
  broadcasts    EmailBroadcast[]
  whatsappBroadcasts WhatsAppBroadcast[]

  @@index([eventId])
}

enum RegistrationStatus {
  STARTED // form opened / InitiateCheckout fired, not yet submitted
  CONFIRMED // submitted, QR issued, Purchase fired
  CANCELLED
}

model Registration {
  id        String             @id @default(cuid())
  event     Event              @relation(fields: [eventId], references: [id])
  eventId   String
  person    Person             @relation(fields: [personId], references: [id])
  personId  String
  status    RegistrationStatus @default(STARTED)

  // Which TicketType this order was for (the "Entradas" step of the
  // public registration modal — see EventRegistration.tsx) — nullable
  // because older/seeded events have no TicketType rows at all yet
  // (registration still works exactly as before for those, ticketCount
  // defaults to 1, no Entradas step shown). SetNull instead of Cascade:
  // deleting a ticket type later must never delete the real people who
  // already registered under it.
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  ticketTypeId String?

  // One person can hold more than one ticket under the same order — e.g.
  // Ticket Tailor's "titular + acompañante" pattern, where the +1's own
  // data is deliberately never collected (friction), but they're still a
  // real body at the door with their own scannable ticket. ticketCount /
  // checkedInCount track that gap so aforo (door headcount) reflects real
  // people, not just identified CRM contacts — see docs/IMPORT.md.

  // Custom form fields captured at registration time, e.g.
  // { "profesion": "manicurista", "empresa": "..." }. Profession is also
  // denormalized onto Person for fast segment filtering.
  customFields Json?

  // Attribution capture — see docs/PLAN.md tracking section.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  fbclid      String?
  ttclid      String?
  gclid       String?

  qrToken   String?  @unique // signed token encoded in the ticket QR
  createdAt DateTime @default(now())
  confirmedAt DateTime?

  // How many tickets this registration represents (titular + up to 1
  // acompañante slot — Ticket Tailor allows max 2 per order today) and how
  // many of those were actually scanned at the door. checkedInCount is
  // counted per physical ticket from the source data, never inferred from
  // the titular's own status — scanning the titular's ticket does NOT
  // imply the +1 also came in. checkedInCount > 0 is "this contact
  // attended" for segment filters (see lib/segments/builder.ts `attended`);
  // SUM(checkedInCount) across an event's registrations is the real door
  // headcount (aforo) — see docs/IMPORT.md and /admin/registrations.
  ticketCount    Int @default(1)
  checkedInCount Int @default(0)

  consents  Consent[]
  metaEvents MetaEvent[]
  scans      ScanLog[]

  @@unique([personId, eventId])
  @@index([eventId, status])
}

// Append-only — see lib/ticket.ts's note on why the QR token itself never
// expires or gets consumed: re-entry (someone steps out for air and comes
// back) has to work, so a scan is a logged event, not a one-time flag. This
// is what makes checkedInCount trustworthy and what /admin/scan reads to
// tell "primera entrada" from "reingreso" from "boleto de otro evento".
enum ScanResult {
  VALID_FIRST // first successful scan of this registration
  VALID_REENTRY // registration already checked in — logged, not an error
  WRONG_EVENT // token is real, but for a different event than this scanner is set to
  INVALID_TOKEN // signature didn't verify, or wasn't shaped like our tokens
  NOT_FOUND // signature verified but no registration exists for that id (e.g. stale/deleted)
}

model ScanLog {
  id             String        @id @default(cuid())
  registration   Registration? @relation(fields: [registrationId], references: [id])
  registrationId String?
  // Raw scanned token, kept even on failure — the only way to debug "the
  // scanner says invalid" complaints after the fact.
  token          String
  result         ScanResult
  // Which event the *scanner* was set to at scan time — not necessarily the
  // registration's own event (that mismatch is exactly what WRONG_EVENT is).
  scannedForEventId String?
  scannedForEvent   Event?   @relation(fields: [scannedForEventId], references: [id])
  // Free-text, e.g. "Puerta 1 - celular de Juan" — no device auth for the
  // MVP, just enough to tell scanners apart in the log.
  scannerLabel   String?
  // The real/claimed moment of the physical scan — for an offline scan
  // (see lib/offlineScan.ts) this is the phone's own clock at scan time,
  // NOT when it reached the server. recordedAt below is the complement:
  // when the server actually wrote this row. They're equal for a normal
  // live scan and diverge only for something synced late — that gap is
  // itself useful signal ("this check-in was recorded 40 minutes after
  // the fact", visible on /admin/scan/stats).
  scannedAt      DateTime      @default(now())
  recordedAt     DateTime      @default(now())
  // Idempotency key, generated client-side per scan attempt (both the
  // live path and the offline queue use it) — a dropped connection can
  // mean the client never learns whether its request actually landed
  // before retrying/syncing it; matching on this instead of blindly
  // re-inserting is what stops that from double-counting a check-in.
  // Null for anything scanned before this existed.
  clientScanId   String?       @unique

  @@index([registrationId])
  @@index([scannedForEventId, scannedAt])
}

// Consent is recorded per purpose, per registration — never one blanket
// checkbox. Ley 1581 (Colombia) requires this to be separable and revocable.
enum ConsentPurpose {
  LOGISTICS // ticket delivery, event-operational emails
  MARKETING // broadcast emails/newsletters
  ADVERTISING // sharing hashed identifiers with Meta/TikTok/Google for audiences
  // Separate from MARKETING on purpose — Meta's WhatsApp policy and Ley 1581
  // both treat WhatsApp opt-in as its own thing, not a checkbox someone
  // already ticked for email. Granted the same way LOGISTICS/MARKETING/
  // ADVERTISING are now (implicit in submitting the registration form, see
  // RegistrationForm.tsx's acceptance line) rather than a separate
  // checkbox — kept as its own purpose here so it stays independently
  // revocable. See docs/WHATSAPP_SETUP.md.
  WHATSAPP
}

model Consent {
  id             String         @id @default(cuid())
  person         Person         @relation(fields: [personId], references: [id])
  personId       String
  registration   Registration?  @relation(fields: [registrationId], references: [id])
  registrationId String?
  purpose        ConsentPurpose
  granted        Boolean
  grantedAt      DateTime       @default(now())
  revokedAt      DateTime?

  @@index([personId, purpose])
}

// ---------------------------------------------------------------------------
// Meta attribution
// ---------------------------------------------------------------------------

// Singleton-ish: one row per Ad Account + Pixel pair. Kept as a table (not a
// single config row) so a future token rotation has an audit trail.
model MetaConnection {
  id                String   @id @default(cuid())
  adAccountId       String
  pixelId           String
  // Encrypted at the application layer before it ever reaches this column —
  // see lib/crypto.ts. Never store the System User token in plaintext.
  systemUserTokenEnc String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum MetaEventName {
  PageView
  ViewContent
  InitiateCheckout
  Purchase
}

enum MetaEventStatus {
  PENDING
  SENT
  FAILED
}

// One row per Conversions API call attempt. event_id is the Meta dedup key
// (shared with the browser Pixel call, if/when one exists) and the unique
// constraint here is what makes retries idempotent.
model MetaEvent {
  id             String          @id @default(cuid())
  eventId        String          @unique // Meta's "event_id" — dedup key
  eventName      MetaEventName
  registration   Registration?   @relation(fields: [registrationId], references: [id])
  registrationId String?
  status         MetaEventStatus @default(PENDING)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  sentAt         DateTime?
  metaResponse   Json?
  createdAt      DateTime        @default(now())

  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Email
// ---------------------------------------------------------------------------

enum EmailKind {
  TRANSACTIONAL
  MARKETING
}

enum BroadcastStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  CANCELLED
}

// A segment definition is stored as the filter tree it represents so it can
// be reused identically for an email broadcast and a Meta/TikTok/Google
// Custom Audience sync — one engine, two consumers (see docs/PLAN.md).
model SegmentDefinition {
  id        String   @id @default(cuid())
  name      String
  // { include: [...conditions], exclude: [...conditions] } — see lib/segments/builder.ts
  filter    Json
  createdAt DateTime @default(now())

  broadcasts EmailBroadcast[]
  whatsappBroadcasts WhatsAppBroadcast[]
  metaSync   SegmentMetaSync?
}

enum SyncStatus {
  PENDING
  OK
  ERROR
}

// Links a named, reusable segment (created from /admin/segments — distinct
// from the throwaway SegmentDefinition rows a one-off broadcast creates) to
// a Meta Custom Audience that a cron keeps in sync automatically. No manual
// "sync now" step — see /api/meta/sync-audiences and syncAllSegmentAudiences().
model SegmentMetaSync {
  id             String     @id @default(cuid())
  segment        SegmentDefinition @relation(fields: [segmentId], references: [id])
  segmentId      String     @unique
  // Filled in on first successful sync — ensureCustomerListAudience() looks
  // audiences up by name too, but caching the id here saves a lookup call
  // per segment per cron run.
  metaAudienceId String?
  status         SyncStatus @default(PENDING)
  lastError      String?
  lastSyncedAt   DateTime?
  createdAt      DateTime   @default(now())
}

// Ticket Tailor's own 4 send-time options on its per-event broadcast
// composer — see EventBroadcastComposer.tsx. IMMEDIATE/AT_DATETIME both
// resolve to a fixed instant; the other two are relative to the event's
// OWN dates, recomputed at send-check time (see lib/broadcastSchedule.ts)
// rather than frozen at creation — editing the event's date after
// scheduling "3 days before it starts" should move the send with it, not
// leave it computed against a date that's no longer true.
enum BroadcastScheduleKind {
  IMMEDIATE
  AT_DATETIME
  BEFORE_EVENT_START
  AFTER_EVENT_END
}

model EmailBroadcast {
  id          String            @id @default(cuid())
  // Nullable now — an event-scoped broadcast (see eventId below) targets
  // "everyone who registered for this event" directly, with no need for a
  // named, reusable SegmentDefinition; that mechanism stays exactly as it
  // was for the original /admin/crm/broadcasts flow, which still requires
  // one (see BroadcastComposer.tsx's own comment on why a raw filter is
  // never accepted there).
  segment     SegmentDefinition? @relation(fields: [segmentId], references: [id])
  segmentId   String?
  // Set only for a broadcast created from an event's own "Correos del
  // evento" page — recipients resolve directly from this event's real
  // registrations (see lib/broadcastRecipients.ts), optionally narrowed
  // to one ticket type below. A broadcast has exactly one of
  // segmentId/eventId set, never both, never neither — enforced in
  // application code (lib/broadcasts.ts), not the DB, same pattern as
  // the rest of this schema's optional-relation pairs.
  event       Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String?
  // "Ticket buyers who bought a specific ticket type" — Ticket Tailor's
  // own recipient-narrowing option. Null = every confirmed registration
  // for the event, regardless of type.
  ticketType   TicketType?      @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  ticketTypeId String?
  // Per-broadcast, unlike OrgSettings.attachTicketPdf (which is the
  // account-wide default for the original confirmation email only) — a
  // marketing broadcast is usually just an announcement, not a ticket
  // resend, so this defaults OFF and the admin opts in per send from
  // EventBroadcastComposer.tsx when they actually want recipients to get
  // their entrada attached again (e.g. a reminder broadcast).
  attachTicketPdf Boolean       @default(false)
  subject     String
  // Plain text — the original /admin/crm/broadcasts flow (escaped +
  // newline-to-<br/> at send time, see lib/email/templates.ts's
  // broadcastEmail). Exactly one of bodyText/bodyHtml is set, matching
  // which composer created the row.
  bodyText    String?
  // Rich-text HTML from the same TipTap editor as the event confirmation
  // and event description (RichTextEditor.tsx) — sanitized server-side
  // before storage, same as those, since it renders in a real inbox.
  bodyHtml    String?
  status      BroadcastStatus   @default(DRAFT)
  scheduleKind BroadcastScheduleKind @default(IMMEDIATE)
  // AT_DATETIME's fixed target instant.
  scheduledAt DateTime?
  // BEFORE_EVENT_START / AFTER_EVENT_END's offset from the event's own
  // startsAt/endsAt — see this enum's own comment on why this is an
  // offset, not a frozen instant.
  scheduleOffsetMinutes Int?
  createdAt   DateTime          @default(now())
  sentAt      DateTime?

  logs EmailLog[]

  @@index([status, scheduleKind])
}

enum EmailLogStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}

// Per-recipient send record for both transactional and broadcast email —
// this is the data the "panel de salud de email" reads from.
model EmailLog {
  id          String          @id @default(cuid())
  kind        EmailKind
  broadcast   EmailBroadcast? @relation(fields: [broadcastId], references: [id])
  broadcastId String?
  personId    String?
  toEmail     String
  sesMessageId String?
  // `status` stays the simple "furthest stage reached" field (already had
  // OPENED/CLICKED/BOUNCED/COMPLAINED in its enum, just never driven by
  // anything until now) — good enough for a list view. The timestamps
  // below are what the person timeline actually reads from, since "cuándo"
  // matters there and a single status can't carry multiple event times.
  // Populated by /api/webhooks/ses (see docs/SES_EVENT_TRACKING.md) —
  // null until that SNS→SES event destination is wired up in AWS, at
  // which point existing rows just start filling in going forward.
  status      EmailLogStatus  @default(QUEUED)
  deliveredAt    DateTime?
  openedAt       DateTime?
  firstClickedAt DateTime?
  bouncedAt      DateTime?
  complainedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([broadcastId, status])
  @@index([toEmail])
  @@index([sesMessageId])
}

// ---------------------------------------------------------------------------
// WhatsApp — CRM → WhatsApp. Direct integration against Meta's WhatsApp
// Cloud API (Graph API), same shape as the Meta ads module above: a
// connection row with an app-layer-encrypted token (lib/crypto.ts), a
// synced read-only mirror of what's approved in Meta's own WhatsApp
// Manager, a broadcast log reusing the same segment engine as email, and
// an inbox (conversation + message) for replying within the 24h customer
// service window. Supersedes the WhatChimp scaffolding in
// lib/whatsapp/whatchimp.ts — see docs/WHATSAPP_SETUP.md.
// ---------------------------------------------------------------------------

// Singleton-ish, same pattern as MetaConnection (a table of rows, most
// recent wins) rather than a true singleton — a future token rotation
// gets an audit trail instead of silently overwriting.
model WhatsAppConnection {
  id             String   @id @default(cuid())
  wabaId         String // WhatsApp Business Account ID
  phoneNumberId  String // the Cloud API "Phone number ID", not the phone number itself
  // Cached from Meta on save/sync, display-only — lets the Conexión page
  // show "conectado como +57 3xx..." without decrypting the token to ask.
  displayPhoneNumber String?
  // Encrypted at the application layer — see lib/crypto.ts. Same posture
  // as MetaConnection.systemUserTokenEnc: never stored in plaintext.
  accessTokenEnc String
  // Shared secret for the webhook GET verification handshake (Meta's
  // hub.verify_token challenge) — set here, then pasted into the same
  // field in the Meta App dashboard's Webhooks config. Not itself
  // sensitive enough to need encryption (it authorizes nothing on its
  // own, same posture as SES_WEBHOOK_SECRET), just needs to match.
  webhookVerifyToken String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Meta's own real template categories/statuses — mirrored exactly so
// syncing never has to invent a mapping.
enum WhatsAppTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum WhatsAppTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
}

// Read-only mirror of what's approved in Meta's own WhatsApp Manager —
// templates are authored and submitted for approval THERE, never
// reinvented in this app (Meta reviews template content directly; there's
// no API for "create and instantly use" without that review anyway). This
// table exists so the broadcast composer can list what's actually usable
// today without an extra round trip to Meta on every page load — kept
// current by the Sync button / a cron hitting lib/whatsapp/templates.ts.
// Only TEXT is built for the header (no image/video/document — that needs
// uploading a sample media asset to Meta first, a separate feature not
// built here). NONE is the common case.
enum WhatsAppTemplateHeaderType {
  NONE
  TEXT
}

model WhatsAppTemplate {
  id            String                   @id @default(cuid())
  metaTemplateId String                  @unique // Meta's own template id
  name          String
  language      String // Meta's language code, e.g. "es" or "es_CO"
  category      WhatsAppTemplateCategory
  status        WhatsAppTemplateStatus
  headerType    WhatsAppTemplateHeaderType @default(NONE)
  headerText    String?
  // The approved body text, placeholders and all (e.g. "Hola {{1}}, tu
  // entrada para {{2}} ya está confirmada.") — shown in the composer so
  // an admin can see what they're mapping variables into.
  bodyText      String?
  variableCount Int                      @default(0)
  footerText    String?
  // Meta's real button component shape, kept exactly as sent/received —
  // e.g. [{"type":"QUICK_REPLY","text":"Sí, voy"}] or
  // [{"type":"URL","text":"Ver evento","url":"https://..."}]. Static only
  // (no dynamic URL suffix) — this app's templates never need one.
  buttons       Json?
  lastSyncedAt  DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  broadcasts WhatsAppBroadcast[]
  messages   WhatsAppMessage[]

  @@unique([name, language])
}

model WhatsAppBroadcast {
  id           String                @id @default(cuid())
  // Same "exactly one of segmentId/eventId, never both, never neither"
  // convention as EmailBroadcast, enforced in application code
  // (lib/whatsapp/broadcasts.ts), not the DB.
  segment      SegmentDefinition?    @relation(fields: [segmentId], references: [id])
  segmentId    String?
  event        Event?                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String?
  ticketType   TicketType?           @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  ticketTypeId String?
  template     WhatsAppTemplate      @relation(fields: [templateId], references: [id])
  templateId   String
  // Which merge tag fills each numbered placeholder in the template body
  // — e.g. {"1": "firstName", "2": "eventName"}. See
  // lib/whatsapp/mergeTags.ts for the fixed set of tags this can reference
  // (mirrors lib/confirmationTemplate.ts's merge-tag approach for email).
  variableMapping Json               @default("{}")
  // Tagged onto every Person who was actually SENT to (not skipped for
  // consent/phone, not FAILED) once the send completes — WhatChimp's own
  // "Assign label after broadcast", useful for excluding this batch from
  // a future round. Null = don't tag anyone.
  assignLabel  Label?                @relation(fields: [assignLabelId], references: [id])
  assignLabelId String?
  status       BroadcastStatus       @default(DRAFT)
  scheduleKind BroadcastScheduleKind @default(IMMEDIATE)
  scheduledAt  DateTime?
  scheduleOffsetMinutes Int?
  // Set when an AT_DATETIME broadcast got a QStash message scheduled for
  // its exact scheduledAt (see lib/qstash.ts) — the daily
  // /api/whatsapp/send-due cron alone can be up to ~24h late (Vercel
  // Hobby plan's cron frequency cap), which isn't "programar para una
  // hora precisa" at all. Null either means IMMEDIATE/not yet scheduled,
  // or QStash wasn't configured/reachable when this was created (the
  // composer surfaces that as a warning) — either way the daily cron
  // still covers it as a fallback, just without the precise timing.
  // Used to cancel the pending QStash message if this broadcast gets
  // deleted before it fires.
  qstashMessageId String?
  createdAt    DateTime              @default(now())
  sentAt       DateTime?

  messages WhatsAppMessage[]

  @@index([status, scheduleKind])
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

// TEMPLATE = outbound, business-initiated, pre-approved template (a
// broadcast send, or the future confirmation-message hookup).
// FREEFORM = outbound plain text, only legal within the 24h window after
// a contact's last inbound message — an inbox reply.
// INBOUND = a real message received from the contact.
enum WhatsAppMessageKind {
  TEMPLATE
  FREEFORM
  INBOUND
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// One row per phone number with any WhatsApp activity — the inbox's
// thread list. Kept even when personId is null (an inbound message from a
// number that doesn't match any known Person by phone yet) so a real
// contact reaching out is never silently dropped for not matching CRM
// data — see lib/whatsapp/inbox.ts.
model WhatsAppConversation {
  id             String    @id @default(cuid())
  person         Person?   @relation(fields: [personId], references: [id])
  personId       String?
  phone          String    @unique // E.164
  // The 24h "customer service window" Meta enforces for FREEFORM sends —
  // always recomputed from this, never cached as a boolean, so it can
  // never go stale mid-conversation.
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  unreadCount    Int       @default(0)
  // Which staff member owns replying to this thread — WhatChimp's own
  // "Assigned Agent", useful once more than one admin works the inbox.
  // Null = unassigned, visible to everyone (today's default behavior
  // unchanged).
  assignedTo     AdminUser? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId   String?
  // The WhatsApp LLM agent (lib/whatsapp/aiAgent.ts) auto-replies to a new
  // inbound message on this thread only while this stays true. Flips to
  // false the moment the agent itself decides to hand off (the customer
  // asked for a human — see the escalate_to_human tool) OR a real staff
  // member sends a manual reply from Bandeja (never let the agent talk
  // over someone who already jumped in). Defaults true so newly-created
  // conversations get an answer immediately, per how this was scoped —
  // "automático a todo mensaje nuevo" — not opt-in per thread.
  aiAutoReplyEnabled Boolean @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages WhatsAppMessage[]
  notes    WhatsAppNote[]

  @@index([personId])
  @@index([assignedToId])
}

// Internal, staff-only note on a conversation — never sent to WhatsApp.
// WhatChimp's own Reply/Note tabs on the same thread; kept as its own
// table (not a WhatsAppMessage kind) since a note has no direction, no
// delivery status, and should never show up in the customer-facing
// message list even by a rendering bug.
model WhatsAppNote {
  id             String               @id @default(cuid())
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  author         AdminUser?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId       String?
  text           String
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
}

model WhatsAppMessage {
  id             String                   @id @default(cuid())
  conversation   WhatsAppConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  direction      WhatsAppMessageDirection
  kind           WhatsAppMessageKind
  // Set only for an OUTBOUND TEMPLATE message sent from a broadcast — this
  // doubles as that broadcast's own EmailLog-equivalent send log.
  broadcast      WhatsAppBroadcast?       @relation(fields: [broadcastId], references: [id])
  broadcastId    String?
  template       WhatsAppTemplate?        @relation(fields: [templateId], references: [id])
  templateId     String?
  // The rendered text: the template body with variables filled in for
  // TEMPLATE, the plain text for FREEFORM/INBOUND.
  body           String?
  providerMessageId String?               @unique
  status         WhatsAppMessageStatus    @default(QUEUED)
  errorMessage   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime                 @default(now())
  // Marks an OUTBOUND FREEFORM message as written by the LLM agent
  // instead of a staff member — purely for the Bandeja thread UI (a
  // small "IA" badge, so staff can tell at a glance what came from the
  // bot vs. a human) and internal audit. Never shown to the customer —
  // WhatsApp has no concept of this, it's an admin-only distinction.
  generatedByAi  Boolean                  @default(false)

  @@index([conversationId, createdAt])
  @@index([broadcastId, status])
}

// ---------------------------------------------------------------------------
// Account-level settings ("Box office settings" in Ticket Tailor's terms —
// nivel 1, one row for the whole account, distinct from any single event).
// ---------------------------------------------------------------------------

// True singleton — always read/written at id "singleton", never
// @default(cuid()) + findFirst like MetaConnection. MetaConnection's
// history-of-rows pattern makes sense for one bundle of correlated secrets
// saved together; this is a settings bag edited piecemeal from several
// different admin pages, so an in-place upsert is the safer fit — a
// partial save from one page can't accidentally revert fields owned by
// another page to their schema defaults.
model OrgSettings {
  id String @id

  // Basic settings
  name     String @default("Nail Fest")
  // IANA timezone, e.g. "America/Bogota" — drives every date/time shown to
  // attendees (event page, confirmation email) and in the admin (scan
  // re-entry time, activity timestamps). See lib/dateFormat.ts.
  timezone String @default("America/Bogota")
  // "es" | "en" — controls the Intl locale used for those same date/time
  // strings (month/day names, AM/PM vs 24h, etc.). Not a full UI
  // translation — the app's own copy stays Spanish either way, there's no
  // i18n string system for that; see lib/dateFormat.ts's own comment.
  language String @default("es")

  // Contact preferences — where replies to any outbound email (ticket
  // confirmations, broadcasts) should land. Wired into email/ses.ts's
  // `send()` as the Reply-To header; null means "reply goes to the From
  // address", same as today's behavior before this existed.
  replyToEmail String?

  // Privacy policy — rendered at /privacidad, linked from the
  // registration form's consent section.
  privacyPolicyText String?

  // Terms and conditions — rendered at /terminos, linked alongside the
  // privacy policy from the same implicit-acceptance line (no separate
  // checkbox: accepting the site's terms is a condition of registering at
  // all, same reasoning as LOGISTICS consent — unlike MARKETING/
  // ADVERTISING, which stay their own explicit opt-in checkbox).
  termsAndConditionsText String?

  // Emails blocked from registering at all — checked in /api/register.
  bannedEmails String[] @default([])

  // Shows a simple cookie notice site-wide when true. Independent of (and
  // in addition to) the explicit ADVERTISING consent checkbox that already
  // gates the Meta Pixel/CAPI — that checkbox covers the ad-sharing
  // purpose specifically; this covers the general "we use cookies" notice
  // Ticket Tailor shows whenever any tracking script is active.
  cookieConsentEnabled Boolean @default(false)

  // Turns on /reenviar — a public "resend my ticket" page that only needs
  // an email address, for people who lost the confirmation email and
  // don't want to fill the whole registration form again.
  selfServeResendEnabled Boolean @default(true)

  // The GLOBAL confirmation email template — rich-text HTML from the same
  // TipTap editor as the event description (RichTextEditor.tsx),
  // sanitized before storage same as that. Null (the default — nobody
  // has to touch this) means "use the existing hand-built design in
  // lib/email/templates.ts's confirmationEmail()" exactly as before this
  // feature existed. See Event.confirmationEmailHtml for the per-event
  // override this falls back to when THAT is also unset — see
  // lib/confirmationTemplate.ts for the merge-tag substitution and the
  // real fallback chain (event -> global -> hand-built default).
  confirmationEmailHtml String?

  // Ticket Tailor's own "Attach ticket vouchers as a PDF" checkbox — global
  // on/off for the printable PDF ticket (lib/ticketPdf.ts) attached to
  // every confirmation email. Defaults to true (matches what the user
  // actually asked for: "que llegue un PDF"). Unlike
  // confirmationEmailHtml above, this has no per-event override — one
  // account-wide switch, same as Ticket Tailor's own single checkbox.
  attachTicketPdf Boolean @default(true)

  // The nailfest.co homepage (src/app/page.tsx) — editable via
  // /admin/homepage. The "next city and dates" block itself is NOT stored
  // here: it's computed live from Event (the published event with the
  // soonest future startsAt), same reasoning as everywhere else in this
  // app — nothing here should be able to drift from real data. These
  // three fields are only the parts an admin actually authors: the hero
  // background (null = the brand teal solid color, no image required to
  // launch), an optional line under the event name/date, and the CTA
  // button's label.
  homepageImageUrl String?
  homepageTagline  String?
  homepageCtaLabel String  @default("Conseguir entrada gratis")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Checkout form — Ticket Tailor's "Buyer questions" editor (see
// /admin/settings/checkout-form and lib/checkoutForm.ts).
// ---------------------------------------------------------------------------

// Deliberately NOT offering Ticket Tailor's "Opt in to receive marketing
// emails" type here — that already exists as a real, connected feature
// (the MARKETING consent checkbox on the form, backed by the Consent
// table and read by hasActiveConsent()/broadcasts). A question of that
// "type" would just write to customFields, disconnected from the actual
// consent system segments and broadcasts check — a decorative duplicate,
// not a real feature. See RegistrationForm.tsx's consent checkboxes instead.
enum CheckoutQuestionType {
  TEXT // single line — matches RegistrationForm's plain <input>
  SELECT // dropdown — same options list as RADIO, different control
  RADIO // single choice — matches the profession-style radio list
  CHECKBOX // multiple choice — answer stored as a comma-joined string
  DATE // <input type="date"> — stored as the ISO date string
  AGREEMENT // one checkbox, label IS the terms text — "must check to submit" when required
}

// Only meaningful for the locked "fullName" row — matches Ticket Tailor's
// own "Format" control on its compulsory Name question. FULL keeps today's
// single field, split into firstName/lastName heuristically server-side
// (lib/name.ts: first word vs. the rest). FIRST_LAST renders two real
// inputs instead and sends firstName/lastName directly — no guessing —
// since Person already stores them as separate columns either way.
enum NameFormat {
  FULL
  FIRST_LAST
}

// One row per question on the registration form. `locked` rows are the six
// structural fields (fullName/email/phone/cedula/city/profession) that
// write into a real Person column or a name the rest of the app already
// depends on (segments filter on city/profession specifically — see
// lib/segments/builder.ts) — those can't be deleted or reordered from the
// admin, only relabeled/toggled required, same as Ticket Tailor's own
// "Name"/"Email" questions being compulsory. Everything else is a normal
// row: create/edit/delete/reorder all really change what
// RegistrationForm.tsx renders and what /api/register accepts — see
// lib/checkoutForm.ts's own comment on why this needed a real table
// instead of the static list this used to be.
model CheckoutQuestion {
  id        String               @id @default(cuid())
  // Stable key — for locked rows this is one of "fullName" | "email" |
  // "phone" | "cedula" | "city" | "profession" and also the key under
  // Registration.customFields the answer is read from for "cedula" (the
  // other locked ones map to real Person columns instead). For unlocked
  // rows it's a generated slug, and customFields is always where the
  // answer lives.
  key       String               @unique
  label     String
  type      CheckoutQuestionType @default(TEXT)
  required  Boolean              @default(false)
  // Only meaningful for SELECT/RADIO/CHECKBOX (see TYPES_WITH_OPTIONS in
  // lib/checkoutForm.ts) — always empty on the locked "profession" row,
  // whose real, admin-editable choices live in ProfessionOption instead
  // (lib/checkoutForm.ts's getCheckoutQuestions overlays that live list
  // onto this field at read time so the admin editor still edits "the
  // question's options" from its point of view).
  options    String[]             @default([])
  order      Int
  locked     Boolean              @default(false)
  // Only meaningful for the locked "fullName" row — see the NameFormat
  // enum's own comment.
  nameFormat NameFormat           @default(FULL)
  // Only meaningful for the locked "email" row — Ticket Tailor's own
  // "Customers have to enter their email twice to avoid typos" toggle.
  // When true, RegistrationForm renders a second confirm-email input and
  // /api/register rejects the submission if the two don't match.
  confirmEmail Boolean            @default(false)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([order])
}

// ---------------------------------------------------------------------------
// Admin auth — real per-person login, replacing the old shared
// ADMIN_USERNAME/ADMIN_PASSWORD HTTP Basic Auth (see middleware.ts's own
// history: that was "enough until real roles" from Slice 1, this is that).
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMIN // full dashboard: Resumen, Eventos, CRM, Configuración, Escáner + Estadísticas
  STAFF // door staff — can only select an event and scan, nothing else
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         AdminRole
  name         String?
  // Soft-disable instead of deleting — keeps ScanLog/etc. history
  // attributable to a real name instead of "deleted user", and lets an
  // admin instantly cut off someone who left without losing their record.
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  assignedConversations WhatsAppConversation[]
  whatsappNotes         WhatsAppNote[]
}

// ---------------------------------------------------------------------------
// Labels — freeform tags on a Person, WhatChimp's own concept (assign a
// label after a broadcast, filter a segment by label). Kept generic (not
// WhatsApp-specific) since a label is just a CRM concept that happens to
// be surfaced first from the WhatsApp module — reusable as a segment
// condition (lib/segments/normalize.ts's "label" field) the same way
// city/profession already are.
// ---------------------------------------------------------------------------

model Label {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  people     Person[]
  broadcasts WhatsAppBroadcast[]
}

// One row per logged-in device — the actual session token. The cookie only
// ever holds a random opaque value; this table holds its SHA-256 hash, so a
// DB leak alone can't be replayed as a live session (same reasoning as
// Registration.qrToken vs. lib/ticket.ts's signed token). Deliberately
// long-lived (see lib/auth/session.ts's SESSION_DAYS) — "once a phone logs
// into the scanner app, it stays logged in" was an explicit ask, not an
// oversight.
model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String?

  @@index([userId])
}
