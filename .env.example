# --- Database (Neon Postgres) ---
# Pooled — the app's normal query traffic. `neon link` / `neon env pull` write
# both of these for you; see docs/NEON_SETUP.md.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
# Direct/unpooled — required for Prisma Migrate, never for app traffic.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# --- App ---
# Generate with `openssl rand -hex 32`. Encrypts the Meta System User token
# at the application layer before it's stored — see src/lib/crypto.ts.
APP_SECRET_KEY=""
APP_BASE_URL="https://register.nailfest.co"
DEFAULT_CURRENCY="COP"
# Placeholder value sent on the Meta "Purchase" event since events are free.
# Swap for a real figure before relying on it for bid optimization (see brief).
META_PURCHASE_PLACEHOLDER_VALUE="1"

# --- Meta (System User token, NOT an OAuth user token — see docs/META_SETUP.md) ---
META_SYSTEM_USER_TOKEN=""
META_AD_ACCOUNT_ID=""      # e.g. act_1234567890
META_PIXEL_ID=""
META_APP_ID=""
META_APP_SECRET=""
# Set while testing in Events Manager > Test Events. Remove for real production sends.
META_TEST_EVENT_CODE=""

# --- Amazon SES ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_TRANSACTIONAL="tickets@nailfest.co"
SES_FROM_MARKETING="hola@nailfest.co"
SES_CONFIGURATION_SET_TRANSACTIONAL="nailfest-transactional"
SES_CONFIGURATION_SET_MARKETING="nailfest-marketing"

# --- Admin panel — real per-person accounts now (admin/staff roles, see
# /admin/settings/users), not HTTP Basic Auth. These two are used ONLY
# once, by /api/admin/bootstrap-admin (see docs/DEPLOY.md step 4b), to
# create your very first admin login — not checked on every request. ---
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# --- Vercel Blob (event cover images, see /admin/events) ---
# Auto-attached by Vercel once a Blob store is connected to this project
# (Vercel dashboard → Storage → Create Database → Blob → set Access to
# Public → check "Add a read-write token env var to this connection") —
# no need to set this by hand for a deploy. Blank locally just means
# image uploads return a clear "not configured" error instead of working;
# everything else in the app is unaffected.
BLOB_READ_WRITE_TOKEN=""

# --- WhatChimp (WhatsApp broadcast) — SUPERSEDED, see docs/WHATCHIMP_SETUP.md.
# Dead vars, safe to remove — the app connects directly to Meta now (below),
# same as the ads/CAPI module. Left here only so an already-deployed
# environment with these set doesn't need an urgent cleanup. ---
WHATCHIMP_API_TOKEN=""
WHATCHIMP_BASE_URL="https://api.whatchimp.com"

# --- WhatsApp (direct Meta Cloud API) — see docs/WHATSAPP_SETUP.md.
# The connection itself (token/WABA ID/phone number ID) is saved from
# /admin/crm/whatsapp/conexion into the database — encrypted, same as the
# Meta ads System User token — NOT set here. META_APP_SECRET above (Meta
# ads section) is reused to verify the webhook's signature; no new app
# secret needed if that's already set. ---

# --- Anthropic (WhatsApp AI agent auto-replies — lib/whatsapp/aiAgent.ts,
# see "Agente de IA — configuración" in docs/WHATSAPP_SETUP.md). Blank
# means every inbound message is just left for a human in Bandeja, same
# as before this feature existed — nothing else in the app depends on it. ---
ANTHROPIC_API_KEY=""

# --- Cron / internal endpoints ---
# Shared secret so /api/meta/retry and /api/meta/sync-audiences can't be hit
# by randoms. Used for manual `curl ... -H "x-cron-secret: ..."` testing.
INTERNAL_CRON_SECRET=""
# Same value as INTERNAL_CRON_SECRET (simplest). Vercel auto-attaches this
# as a Bearer token when it triggers the crons declared in vercel.json — see
# docs/DEPLOY.md. Set it and the crons run with zero dashboard setup.
CRON_SECRET=""
